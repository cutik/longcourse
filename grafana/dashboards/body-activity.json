{
  "uid": "longcourse-body",
  "title": "Longcourse · Body & activity",
  "tags": [
    "longcourse"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30m",
  "editable": true,
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Datasource",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Weight",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, value AS kg FROM v_daily_metrics\nWHERE $__timeFilter(time) AND metric = 'weight' ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kg",
          "custom": {
            "drawStyle": "line",
            "showPoints": "always",
            "spanNulls": true,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Body fat",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, value AS pct FROM v_daily_metrics\nWHERE $__timeFilter(time) AND metric = 'body_fat' ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Steps",
      "description": "One source per day only. iPhone and Watch both record steps, so summing every record would roughly double the real figure; the best-covered source wins.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, value AS steps FROM v_daily_metrics\nWHERE $__timeFilter(time) AND metric = 'steps' ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Active energy",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, value AS kcal FROM v_daily_metrics\nWHERE $__timeFilter(time) AND metric = 'active_energy' ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "unit": "kcal"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Exercise minutes",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, value AS minutes FROM v_daily_metrics\nWHERE $__timeFilter(time) AND metric = 'exercise_time' ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "unit": "m"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Walking + running distance",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, value AS metres FROM v_daily_metrics\nWHERE $__timeFilter(time) AND metric = 'distance_walking' ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "unit": "lengthm"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "Which source is being trusted for each metric",
      "description": "Sanity check for the double-counting rule. A cumulative metric showing two different sources across the range means the primary device changed — expect a step in the series there.",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT metric, kind, unit, source, MAX(samples) AS \"samples/day\", COUNT(*) AS days\nFROM v_daily_metrics\nWHERE $__timeFilter(time)\nGROUP BY 1,2,3,4 ORDER BY 1,4\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}

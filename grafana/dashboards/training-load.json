{
  "uid": "longcourse-load",
  "title": "Longcourse · Training load",
  "tags": [
    "longcourse"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30m",
  "editable": true,
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Datasource",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "current": {},
        "hide": 0
      },
      {
        "name": "sport",
        "label": "Sport",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "SELECT DISTINCT sport FROM v_training_load ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Weekly distance by sport",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, sport, SUM(distance_m) AS distance\nFROM v_training_load\nWHERE $__timeFilter(time) AND sport IN ($sport)\nGROUP BY 1, 2 ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "unit": "lengthm"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Weekly active hours by sport",
      "description": "Active time where it is known, elapsed time otherwise.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, sport, SUM(active_s)/3600.0 AS hours\nFROM v_training_load\nWHERE $__timeFilter(time) AND sport IN ($sport)\nGROUP BY 1, 2 ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "unit": "h"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Sessions per week",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, sport, SUM(sessions) AS sessions\nFROM v_training_load\nWHERE $__timeFilter(time) AND sport IN ($sport)\nGROUP BY 1, 2 ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Average heart rate per week",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, sport, AVG(avg_hr) AS hr\nFROM v_training_load\nWHERE $__timeFilter(time) AND sport IN ($sport)\nGROUP BY 1, 2 ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "none"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "Recent sessions, all sports",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT time AS \"start\", sport, is_indoor AS \"indoor\", distance_m AS \"m\",\n       ROUND(duration_s/60) AS \"min\", ROUND(avg_kmh::numeric, 2) AS \"km/h\",\n       ROUND(active_kcal::numeric) AS kcal, avg_hr, max_hr\nFROM v_sessions\nWHERE $__timeFilter(time) AND sport IN ($sport)\nORDER BY time DESC LIMIT 200\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}

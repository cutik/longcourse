{
  "uid": "longcourse-recovery",
  "title": "Longcourse · Sleep & recovery",
  "tags": [
    "longcourse"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30m",
  "editable": true,
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Datasource",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Sleep by stage",
      "description": "Nights are filed against the morning you woke up on. Nights that predate staged sleep tracking show as a single unspecified block in the asleep total and contribute nothing to these stages.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, deep_s/3600.0 AS deep, rem_s/3600.0 AS rem, core_s/3600.0 AS core,\n       awake_s/3600.0 AS awake\nFROM v_sleep_nights\nWHERE $__timeFilter(time)\nORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "unit": "h"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Sleep efficiency",
      "description": "Asleep over time in bed. Blank when no in-bed record exists.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, efficiency FROM v_sleep_nights\nWHERE $__timeFilter(time) AND efficiency IS NOT NULL ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "HRV (SDNN)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, value AS hrv, min, max FROM v_daily_metrics\nWHERE $__timeFilter(time) AND metric = 'hrv_sdnn' ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Resting heart rate",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, value AS rhr FROM v_daily_metrics\nWHERE $__timeFilter(time) AND metric = 'resting_heart_rate' ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Respiratory rate",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, value AS \"breaths/min\" FROM v_daily_metrics\nWHERE $__timeFilter(time) AND metric = 'respiratory_rate' ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "VO2 max",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, value AS vo2max FROM v_daily_metrics\nWHERE $__timeFilter(time) AND metric = 'vo2max' ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Blood oxygen",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, value AS spo2, min, max FROM v_daily_metrics\nWHERE $__timeFilter(time) AND metric = 'blood_oxygen' ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Sleeping wrist temperature",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT time, value AS \"deviation\" FROM v_daily_metrics\nWHERE $__timeFilter(time) AND metric = 'wrist_temperature' ORDER BY 1\n",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
